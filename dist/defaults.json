{
    "rust-analyzer": {
        "command": "rust-analyzer",
        "args": [],
        "fileTypes": [
            ".rs"
        ],
        "rootMarkers": [
            "Cargo.toml",
            "rust-analyzer.toml"
        ],
        "initOptions": {},
        "settings": {
            "rust-analyzer": {
                "checkOnSave": false
            }
        },
        "capabilities": {
            "flycheck": true,
            "ssr": true,
            "expandMacro": true,
            "runnables": true,
            "relatedTests": true
        },
        "setup": {
            "install": "rustup component add rust-analyzer",
            "docs": "https://rust-analyzer.github.io/book/installation.html"
        }
    },
    "tlaplus": {
        "command": "tlapm_lsp",
        "args": [
            "--stdio"
        ],
        "fileTypes": [
            ".tla",
            ".tlaplus"
        ],
        "rootMarkers": [
            "*.tla"
        ],
        "setup": {
            "install": "Install TLAPS for this OS, then build or enable its optional LSP adapter (`tlapm_lsp`) following the upstream repository instructions.",
            "docs": "https://github.com/tlaplus/tlapm"
        }
    },
    "clangd": {
        "command": "clangd",
        "args": [
            "--background-index",
            "--clang-tidy",
            "--header-insertion=iwyu"
        ],
        "fileTypes": [
            ".c",
            ".cpp",
            ".cc",
            ".cxx",
            ".h",
            ".hpp",
            ".hxx",
            ".cu",
            ".cuh",
            ".m",
            ".mm"
        ],
        "rootMarkers": [
            "compile_commands.json",
            "CMakeLists.txt",
            ".clangd",
            ".clang-format",
            "Makefile"
        ],
        "setup": {
            "install": {
                "darwin": "brew install llvm",
                "linux": [
                    "Debian/Ubuntu (apt): sudo apt install clangd",
                    "Fedora (dnf): sudo dnf install clang-tools-extra",
                    "Arch (pacman): sudo pacman -S clang"
                ],
                "win32": "winget install LLVM.LLVM"
            },
            "docs": "https://clangd.llvm.org/installation.html"
        }
    },
    "zls": {
        "command": "zls",
        "args": [],
        "fileTypes": [
            ".zig"
        ],
        "rootMarkers": [
            "build.zig",
            "build.zig.zon",
            "zls.json"
        ],
        "setup": {
            "install": {
                "darwin": [
                    "Recommended: use the official install tool to match the installed Zig version.",
                    "Homebrew: brew install zls"
                ],
                "default": "Use the official ZLS installer to select a build compatible with the installed Zig version."
            },
            "docs": "https://zigtools.org/zls/install/"
        }
    },
    "gopls": {
        "command": "gopls",
        "args": [
            "serve"
        ],
        "fileTypes": [
            ".go",
            ".mod",
            ".sum"
        ],
        "rootMarkers": [
            "go.mod",
            "go.work",
            "go.sum"
        ],
        "settings": {
            "gopls": {
                "analyses": {
                    "unusedparams": true,
                    "shadow": true
                },
                "staticcheck": true,
                "gofumpt": true
            }
        },
        "setup": {
            "install": "go install golang.org/x/tools/gopls@latest",
            "docs": "https://go.dev/gopls/"
        }
    },
    "typescript-language-server": {
        "command": "typescript-language-server",
        "args": [
            "--stdio"
        ],
        "fileTypes": [
            ".ts",
            ".tsx",
            ".mts",
            ".cts",
            ".js",
            ".jsx",
            ".mjs",
            ".cjs"
        ],
        "rootMarkers": [
            "package.json",
            "tsconfig.json",
            "jsconfig.json"
        ],
        "initOptions": {
            "hostInfo": "omp-coding-agent",
            "preferences": {
                "includeInlayParameterNameHints": "all",
                "includeInlayVariableTypeHints": true,
                "includeInlayFunctionParameterTypeHints": true
            }
        },
        "setup": {
            "install": "npm install -g typescript-language-server typescript",
            "docs": "https://www.npmjs.com/package/typescript-language-server"
        }
    },
    "biome": {
        "command": "biome",
        "args": [
            "lsp-proxy"
        ],
        "fileTypes": [
            ".ts",
            ".tsx",
            ".js",
            ".jsx",
            ".mjs",
            ".cjs",
            ".json",
            ".jsonc",
            ".css"
        ],
        "rootMarkers": [
            "biome.json",
            "biome.jsonc"
        ],
        "isLinter": true,
        "setup": {
            "install": "npm install -g @biomejs/biome",
            "docs": "https://biomejs.dev/installation/install-biome/"
        }
    },
    "eslint": {
        "command": "vscode-eslint-language-server",
        "args": [
            "--stdio"
        ],
        "fileTypes": [
            ".ts",
            ".tsx",
            ".js",
            ".jsx",
            ".mjs",
            ".cjs",
            ".vue",
            ".svelte"
        ],
        "rootMarkers": [
            ".eslintrc",
            ".eslintrc.js",
            ".eslintrc.json",
            ".eslintrc.yml",
            "eslint.config.js",
            "eslint.config.mjs"
        ],
        "isLinter": true,
        "settings": {
            "validate": "on",
            "run": "onType"
        },
        "setup": {
            "install": "npm install -g vscode-langservers-extracted",
            "docs": "https://github.com/hrsh7th/vscode-langservers-extracted"
        }
    },
    "denols": {
        "command": "deno",
        "args": [
            "lsp"
        ],
        "fileTypes": [
            ".ts",
            ".tsx",
            ".js",
            ".jsx"
        ],
        "rootMarkers": [
            "deno.json",
            "deno.jsonc",
            "deno.lock"
        ],
        "initOptions": {
            "enable": true,
            "lint": true,
            "unstable": true
        },
        "setup": {
            "install": {
                "darwin": "brew install deno",
                "linux": "curl -fsSL https://deno.land/install.sh | sh",
                "win32": "PowerShell: irm https://deno.land/install.ps1 | iex"
            },
            "docs": "https://docs.deno.com/runtime/getting_started/installation/"
        }
    },
    "vscode-html-language-server": {
        "command": "vscode-html-language-server",
        "args": [
            "--stdio"

        "rootMarkers": [
            "pyproject.toml",
            "pyrightconfig.json",
            "setup.py",
            "setup.cfg",
            "requirements.txt",
            "Pipfile"
        ],
        "settings": {
            "python": {
                "analysis": {
                    "autoSearchPaths": true,
                    "diagnosticMode": "openFilesOnly",
                    "useLibraryCodeForTypes": true
                }
            }
        },
        "setup": {
            "install": "npm install -g pyright",
            "docs": "https://github.com/microsoft/pyright/blob/main/docs/installation.md"
        }
    },
    "pyrefly-tsp": {
        "command": "pyrefly",
        "args": ["tsp"],
        "protocol": "tsp",
        "fileTypes": [".py", ".pyi"],
        "rootMarkers": ["pyrefly.toml", "pyproject.toml", "setup.py", "setup.cfg", "requirements.txt", ".git"],
        "setup": {
            "install": "uv tool install pyrefly",
            "docs": "https://pyrefly.org/blog/pyrefly-pylance/"
        }

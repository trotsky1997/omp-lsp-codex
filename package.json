{
  "name": "codex-lsp",
  "version": "0.4.24",
  "description": "Standalone TypeScript LSP CLI, skills and hooks for coding agents",
  "license": "MIT",
  "repository": "https://github.com/trotsky1997/omp-lsp-codex",
  "bin": {
    "codex-lsp": "dist/cli.js"
  },
  "files": [
    "dist",
    "native/rust-types/Cargo.toml",
    "native/rust-types/Cargo.lock",
    "native/rust-types/src",
    "hooks",
    "skills",
    "plugin.json",
    ".claude-plugin",
    ".agents",
    "LICENSE",
    "LICENSES",
    "NOTICE.md",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test \".test-build/tests/*.test.js\" && node .test-build/scripts/check.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "typescript7": "npm:typescript@7.0.2"
  },
  "engines": {
    "node": ">=22.20.0"
  }
}

{
  "description": "Expose available LSP servers at session start and check changed source files before Claude Code stops.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/cli.js\" hook session-start",
            "timeout": 10,
            "statusMessage": "Checking language server availability"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/cli.js\" hook stop",
            "timeout": 120,
            "statusMessage": "Checking changed files with LSP"
          }
        ]
      }
    ]
  }
}
